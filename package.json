{
  "name": "wicken",
  "version": "2.0.0",
  "private": true,
  "description": "Wicken - a furniture and ceramics store. Next.js App Router, Postgres, Stripe.",
  "author": "Adrian Jimenez",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuppetAJ/Wicken.git"
  },
  "bugs": {
    "url": "https://github.com/PuppetAJ/Wicken/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "NODE_ENV=test node --conditions=react-server --env-file-if-exists=.env scripts/setup-test-db.ts && NODE_ENV=test STRIPE_SECRET_KEY=sk_test_signing_only STRIPE_WEBHOOK_SECRET=whsec_signing_only node --conditions=react-server --env-file-if-exists=.env --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:e2e": "node --env-file-if-exists=.env e2e/run.mjs",
    "test:a11y": "node e2e/a11y.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node-pg-migrate up --envPath .env -m migrations",
    "db:migrate:down": "node-pg-migrate down --envPath .env -m migrations",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env scripts/seed.ts",
    "db:seed:empty": "node --conditions=react-server --env-file-if-exists=.env scripts/seed-if-empty.ts"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app/globals.css",
    "tailwindFunctions": [
      "clsx"
    ]
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^13.4.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "node-pg-migrate": "^9.0.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "railway": "^3.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
